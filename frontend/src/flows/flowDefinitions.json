            "subject": "{{triggerData.requestNumber}} — Onayınızı bekliyor",
            "body": "<p>Sayın yetkili,</p><p><strong>{{triggerData.requestNumber}}</strong> numaralı satın alma talebi onayınızı beklemektedir.</p>",
            "contentType": "html"
          }
        }
      },
